{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "pitch": {
      "description": "Pitch",
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "description": "Title",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\r\\n]*$",
      "type": "string"
    },
    "type": {
      "const": "idea"
    },
    "why": {
      "description": "Why it fits",
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "type",
    "title",
    "pitch",
    "why"
  ],
  "title": "A idea suggestion for Idle-ish",
  "type": "object"
}
