/target/
# Unanchored as well: ferryman-tray is excluded from the workspace, so it has its own
# target directory, and /target/ does not match it. Without this, building the tray
# leaves hundreds of megabytes of artefacts showing as untracked - which is how they
# eventually get committed.
target/
# Release packaging output.
/dist/
/.data/
*.db
*.db-shm
*.db-wal
.env

# Local runtime + evaluation artifacts (never commit)
/.data/
*.log
key-bootstrap.out
EVAL_FINDINGS.md

# Scratch files used when authoring commits/releases locally - never part of the repo.
/.m[0-9]*.txt
/.rel.md
/.verify.sh
/.port*.patch
/_build.log

# graphify knowledge-graph output (generated locally, never commit)
graphify-out/

# Agent memory bank (shared across machines by Syncthing, never committed)
memory-bank

# Ferryman's attachment: this machine's config, its synced channel, and its
# PRIVATE SIGNING KEY. None of it belongs in the work repository - committing
# .ferryman/keys would publish an identity every machine in your fleet trusts.
/.ferryman/

# Scratch shells from debugging sessions. They are useful on the machine that
# wrote them and meaningless anywhere else; one of them got committed by an
# over-broad `git add -A` during a conflict resolution.
sandbox*.sh
sbxresult.sh
BEASTLYWSL_PROMPT.md
